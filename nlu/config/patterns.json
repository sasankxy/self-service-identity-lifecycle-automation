    "ACCESS_REQUEST": [
      {
        "regex": "\\b(?:request|requests|requested|requesting|need|needs|needed|require|requires|required|want|wants|wanted|like|get|gets|give|gives|grant|grants|granted|granting|provision|provisions|provisioned|provisioning|enable|enables|assign|assigns|allow|allows|add)\\b.{0,35}?\\b(?:access|permissions?|privileges|rights)\\b",
        "weight": 3
      },
      {
        "regex": "\\b(?:can|could|may|might)\\s+(?:i|we|he|she|they)\\s+(?:please\\s+)?have\\b.{0,25}\\baccess\\b",
        "weight": 3
      },
      {
        "regex": "\\baccess\\s+(?:to|for)\\b",
        "weight": 1.5
      },
      {
        "regex": "\\b(?:add|assign|put|make)\\b.{0,40}?\\b(?:to|as)\\b.{0,30}?\\b(?:role|group)\\b",
        "weight": 3
      }
    ],
    "ACCESS_REVOCATION": [
      {
        "regex": "\\brevok(?:e|es|ing)\\b",
        "weight": 3
      },
      {
        "regex": "\\brevoked\\b",
        "weight": 1.5
      },
      {
        "regex": "\\b(?:remove|removes|removing|delete|deleting|disable|disables|disabling|deactivate|deactivating|suspend|suspending|cut\\s+off|take\\s+away|taking\\s+away|strip|withdraw|withdrawing|terminate|terminating|drop)\\b.{0,35}?\\b(?:access|permissions?|privileges|rights|entitlements?)\\b",
        "weight": 3
      },
      {
        "regex": "\\b(?:deprovision\\w*|de-provision\\w*|unassign\\w*)\\b",
        "weight": 3
      },
      {
        "regex": "\\bno\\s+longer\\s+(?:need|needs|require|requires)\\b",
        "weight": 2.5
      },
      {
        "regex": "\\b(?:remove|delete|drop|take)\\b.{0,40}?\\bfrom\\b.{0,30}?\\b(?:role|group)\\b",
        "weight": 3
      }
    ],
    "ACCESS_STATUS_QUERY": [
      {
        "regex": "\\b(?:do|does|did|am|is|are|has|have)\\b.{0,25}?\\b(?:have|has|got|retain|keep)\\b.{0,25}?\\baccess\\b",
        "weight": 3,
        "suppresses": [
          "ACCESS_REQUEST",
          "ACCESS_REVOCATION"
        ]
      },
      {
        "regex": "\\b(?:what|which)\\b.{0,25}?\\b(?:access|apps|applications|permissions|roles|systems|entitlements|privileges)\\b",
        "weight": 3
      },
      {
        "regex": "\\b(?:check|verify|confirm|show|list|view|see|display|review)\\b.{0,30}?\\b(?:access|permissions|entitlements|roles|privileges)\\b",
        "weight": 3
      },
      {
        "regex": "\\bstatus\\b.{0,30}?\\b(?:access|request|permissions?|account)\\b|\\baccess\\s+status\\b",
        "weight": 3.5,
        "suppresses": [
          "ACCESS_REQUEST",
          "ACCESS_REVOCATION"
        ]
      },
      {
        "regex": "^(?:has|have|is|was|were|did|does)\\b.{0,50}?\\b(?:revoked|removed|granted|provisioned|approved|disabled|deleted)\\b",
        "weight": 3,
        "suppresses": [
          "ACCESS_REQUEST",
          "ACCESS_REVOCATION"
        ]
      },
      {
        "regex": "\\b(?:granted|provisioned|approved|revoked|removed|disabled)\\b.{0,10}\\?\\s*$",
        "weight": 2.5
      }
    ]
  },
