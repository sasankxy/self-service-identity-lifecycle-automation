  ],
  "temporal_patterns": [
    {
      "name": "end_of_period",
      "regex": "\\b(?:(?:at|by|on)\\s+)?(?:the\\s+)?end\\s+of\\s+(?:the\\s+|this\\s+|next\\s+)?(?:month|week|quarter|year)\\b"
    },
    {
      "name": "relative_day",
      "regex": "\\b(?:today|tomorrow|yesterday|tonight)\\b"
    },
    {
      "name": "weekday",
      "regex": "\\b(?:(?:this|next|last|coming)\\s+)?(?:monday|tuesday|wednesday|thursday|friday|saturday|sunday)\\b"
    },
    {
      "name": "relative_period",
      "regex": "\\b(?:next|this|last|following)\\s+(?:week|month|quarter|year|weekend)\\b"
    },
    {
      "name": "in_n_units",
      "regex": "\\bin\\s+(?:\\d+|an?|one|two|three|four|five|six|seven|eight|nine|ten|a\\s+couple\\s+of|a\\s+few)\\s+(?:days?|weeks?|months?)\\b"
    },
    {
      "name": "day_month",
      "regex": "\\b\\d{1,2}(?:st|nd|rd|th)?\\s+(?:of\\s+)?(?:jan(?:uary)?|feb(?:ruary)?|mar(?:ch)?|apr(?:il)?|may|jun(?:e)?|jul(?:y)?|aug(?:ust)?|sep(?:t(?:ember)?)?|oct(?:ober)?|nov(?:ember)?|dec(?:ember)?)\\b(?:,?\\s+\\d{4})?"
    },
    {
      "name": "month_day",
      "regex": "\\b(?:jan(?:uary)?|feb(?:ruary)?|mar(?:ch)?|apr(?:il)?|jun(?:e)?|jul(?:y)?|aug(?:ust)?|sep(?:t(?:ember)?)?|oct(?:ober)?|nov(?:ember)?|dec(?:ember)?)\\.?\\s+\\d{1,2}(?:st|nd|rd|th)?\\b(?:,?\\s+\\d{4})?"
    },
    {
      "name": "iso",
      "regex": "\\b\\d{4}-\\d{2}-\\d{2}\\b"
    },
    {
      "name": "slash",
      "regex": "\\b\\d{1,2}/\\d{1,2}/\\d{2,4}\\b"
    }
  ],
  "employee_id_patterns": [
    {
      "regex": "\\b(?:EMP|EID)[-_]?\\d{3,8}\\b",
      "group": 0
    },
    {
      "regex": "\\bE[-_]?\\d{4,8}\\b",
      "group": 0
    },
    {
      "regex": "\\b(?:employee|emp)\\s*(?:id|number|no\\.?)\\s*[:#]?\\s*(\\d{3,8})\\b",
